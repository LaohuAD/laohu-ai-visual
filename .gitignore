/00_输入原料/研究文档/nuyoah-portrait-character-designer/

# Personal work projects stay local. Git tracks only the three status
# directory placeholders so the reusable project skeleton remains visible.
/01_作品项目/进行中/*
!/01_作品项目/进行中/.gitkeep
/01_作品项目/已完成/*
!/01_作品项目/已完成/.gitkeep
/01_作品项目/已发布/*
!/01_作品项目/已发布/.gitkeep

# Generated heavy media can be archived locally.
# Keep .gitkeep so the project structure remains visible.
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wav
*.mp3
*.flac
*.aiff
*.psd
*.psb
!**/.gitkeep

# Full provenance and user-authorized portable story atoms stay private to local/selected upload.
/02_共享资产库/故事素材库/
/.agents/skills/laohu-script-writer/references/故事原子/

# Nested copies of private story atoms inside packaged skills stay local too.
**/内置方法/laohu-script-writer/references/故事原子/
