.DS_Store
Thumbs.db

# Local agent / editor state
.evolver/
.obsidian/
.idea/
.vscode/

# Dependencies and build output
node_modules/
dist/
build/
.next/
.turbo/

# Logs and temporary files
*.log
*.tmp
*.bak
__pycache__/
*.py[cod]
/tmp/
/output/
/docs/superpowers/

# Private story observations and source transcripts stay local.
/00_输入原料/故事素材原子库.jsonl
/00_输入原料/故事素材库/

# Personal work projects stay local. Git tracks only the three status
# directory placeholders so the reusable project skeleton remains visible.
/01_作品项目/进行中/*
!/01_作品项目/进行中/.gitkeep
/01_作品项目/已完成/*
!/01_作品项目/已完成/.gitkeep
/01_作品项目/已发布/*
!/01_作品项目/已发布/.gitkeep

# Generated heavy media can be archived locally.
# Keep .gitkeep so the project structure remains visible.
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wav
*.mp3
*.flac
*.aiff
*.psd
*.psb
!**/.gitkeep
